# ==============================================================================
# PROJECT TERRA — Environment Configuration Template
# Copy to `.env` (`cp .env.example .env`) and replace placeholder secrets.
# Never commit `.env` or real credentials to version control.
# ==============================================================================

# --- 1. Application Runtime ---
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true

# --- 2. Frontend (Vite SPA) ---
FRONTEND_PORT=5173
# Leave VITE_API_BASE_URL empty in development to route `/api` and `/health` through
# Vite's same-origin proxy (recommended for HttpOnly cookie sessions).
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_NASA_GIBS_BASE_URL=https://gibs.earthdata.nasa.gov
# VITE_MAP_STYLE_URL=

# --- 3. Service Addressing (Core API & GHS) ---
CORE_HOST=127.0.0.1
CORE_PORT=8000
GHS_HOST=127.0.0.1
GHS_PORT=8080
GHS_BASE_URL=http://127.0.0.1:8080
GHS_TIMEOUT_SECONDS=30.0

# --- 4. Databases (Use absolute paths for SQLite across processes) ---
# Core API and Core Worker share DATABASE_URL.
# Default when unset in development resolves to `<repo>/.data/terra.db`.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/project-terra/.data/terra.db
# PostgreSQL example for Core:
# DATABASE_URL=postgresql+asyncpg://terra:terra@127.0.0.1:5432/terra_core

# GHS API and GHS Worker share GHS_DATABASE_URL (independent from Core DATABASE_URL).
# Default when unset resolves to `<repo>/.data/ghs.db`.
# GHS_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/project-terra/.data/ghs.db
# PostgreSQL example for GHS:
# GHS_DATABASE_URL=postgresql+asyncpg://ghs:ghs@127.0.0.1:5432/terra_ghs
DATABASE_ECHO=false
DATABASE_AUTO_CREATE_TABLES=true

# --- 5. Worker Configuration ---
TERRA_WORKER_POLL_SECONDS=2.0
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_LEASE_SECONDS=300

# --- 6. Authentication & Session Security ---
# Signing key for Core JWT session cookies (>= 32 chars).
# Where to get: Generate locally with `openssl rand -hex 32`. Where to put: `.env` (Core API).
JWT_SECRET_KEY=dev-only-jwt-secret-key-replace-before-production-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=terra_session
AUTH_COOKIE_SECURE=false
# GitHub OAuth App credentials (optional in development thanks to /api/v1/auth/dev-session).
# Where to get: GitHub Developer Settings -> OAuth Apps. Where to put: `.env` (Core API).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/v1/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email
FRONTEND_AUTH_REDIRECT_URL=http://localhost:5173/explore

# --- 7. NASA & Earth Observation Providers ---
# Required for live MODIS, GPM IMERG, and SMAP granule downloads via Earthdata Cloud.
# Where to get: https://urs.earthdata.nasa.gov/user_tokens (Generate Token). Where to put: `.env` (GHS).
EARTHDATA_TOKEN=
CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
APPEEARS_BASE_URL=https://appeears.earthdatacloud.nasa.gov/api
MODIS_ENABLED=true
GPM_ENABLED=true
SMAP_ENABLED=true
NASA_POWER_ENABLED=true
GENERIC_HANDLER_ALLOWED_HOSTS=[]
RUN_LIVE_NASA_TESTS=0

# --- 8. Storage, Compression, Cloudflare R2 & Scientific Artifacts ---
# Local staging/artifact directory for Core Scientific output files before/alongside object storage.
# SCIENTIFIC_ARTIFACT_DIR=/absolute/path/to/project-terra/.data/artifacts
# Core local object store directory when STORAGE_BACKEND=local (defaults to `<SCIENTIFIC_ARTIFACT_DIR>/object_store`).
# CORE_LOCAL_OBJECT_STORE_DIR=/absolute/path/to/project-terra/.data/artifacts/object_store
# Active object storage backend shared by Core, Core Worker, GHS, and GHS Worker: `local` or `s3` (Cloudflare R2).
STORAGE_BACKEND=local
# GHS local filesystem root when STORAGE_BACKEND=local.
# LOCAL_STORAGE_DIR=/absolute/path/to/project-terra/.data/ghs_storage
GHS_STORAGE_BUDGET_BYTES=8000000000
GHS_STORAGE_MAX_OBJECT_BYTES=2147483648
GHS_STORAGE_MAX_JOB_OUTPUT_BYTES=1073741824
GHS_STORAGE_RASTER_CODEC=ZSTD
GHS_STORAGE_RASTER_COG_ENABLED=true
GHS_STORAGE_NETCDF_COMPLEVEL=5
GHS_STORAGE_ZARR_CODEC=zstd
GHS_STORAGE_MIN_RECOMPRESS_SAVINGS_RATIO=0.05
GHS_STORAGE_RAW_RETENTION_DAYS=30
GHS_STORAGE_DERIVED_RETENTION_DAYS=30
# Optional static admin token protecting GHS POST /api/v1/storage/reconcile & /cleanup.
# Where to get: Generate with `openssl rand -hex 32`. Where to put: `.env` (GHS admin operations).
GHS_ADMIN_TOKEN=

# --- Cloudflare R2 / S3-Compatible Object Storage (active when STORAGE_BACKEND=s3) ---
# S3_BUCKET: Private bucket name shared cleanly via isolated key prefixes (`raw/`, `intermediate/`, `derived/` for GHS; `core/` for Core).
# Where to get: Cloudflare Dashboard -> R2 Object Storage -> Bucket Name (e.g. `terra`). Where to put: `.env`.
S3_BUCKET=
# S3_ENDPOINT_URL: Account-level S3 API endpoint WITHOUT trailing `/<bucket>` (boto3 path-style appends `/<bucket>`).
# Where to get: Cloudflare Dashboard -> R2 -> Overview -> Account ID -> `https://<ACCOUNT_ID>.r2.cloudflarestorage.com`. Where to put: `.env`.
S3_ENDPOINT_URL=
# S3_REGION: Must be `auto` for Cloudflare R2 (or standard AWS region such as `us-east-1` for AWS S3/MinIO).
# Where to get: Cloudflare R2 documentation (fixed `auto`). Where to put: `.env`.
S3_REGION=auto
# AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY: S3 API Access Key pair (Core also accepts S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY aliases).
# Where to get: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token (Object Read & Write permission scoped to the bucket). Where to put: `.env` only (never commit!).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefix isolation inside the shared bucket so GHS and Core never collide:
# S3_PREFIX: Optional prefix prepended to GHS zones (`raw/`, `intermediate/`, `derived/`). Leave empty for bucket root zones.
S3_PREFIX=
# CORE_S3_PREFIX: Prefix for Core assessment results, provenance manifests, and exports (`core/assessments/<id>/...`).
CORE_S3_PREFIX=core
# Presigned GET URL lifetime (seconds, 30..3600) for direct authorized client downloads from private R2 bucket (requires R2 bucket CORS).
S3_PRESIGN_TTL_SECONDS=300
# S3/R2 SDK connection timeout (s), read timeout (s), and max SigV4 standard retry attempts.
S3_CONNECT_TIMEOUT_SECONDS=10.0
S3_READ_TIMEOUT_SECONDS=60.0
S3_MAX_ATTEMPTS=4
