# ==============================================================================
# PROJECT TERRA — Docker Compose Environment Configuration Reference
#
# This file defines and documents all environment variables consumed by
# `compose.dev.yaml` and `compose.prod.yaml`.
#
# Quickstart:
#   Development: cp deploy/containerization/.env.compose.example .env
#   Production:  cp deploy/containerization/.env.compose.example .env.production
# ==============================================================================

# ==============================================================================
# 1. DATABASE & POSTGRESQL INFRASTRUCTURE
# ==============================================================================

# POSTGRES_USER
# - Purpose: Administrative username for the shared PostgreSQL container.
# - Required: Optional (Defaults to `postgres`).
# - Consumed by: `postgres`, `ghs-migration`, `ghs-api`, `ghs-worker`, `core`, `core-worker`.
# - Secret: No.
# - Expected format: Alphanumeric username string (e.g., `postgres` or `terra_admin`).
# - Value source: Defined by infrastructure operator.
POSTGRES_USER=postgres

# POSTGRES_PASSWORD
# - Purpose: Authentication password for the PostgreSQL service.
# - Required: Optional in development (defaults to `postgres`); MANDATORY in production.
# - Consumed by: `postgres`, `ghs-migration`, `ghs-api`, `ghs-worker`, `core`, `core-worker`.
# - Secret: YES (High severity).
# - Expected format: High-entropy string (>= 16 characters).
# - Value source: Generated via `openssl rand -hex 24`.
POSTGRES_PASSWORD=replace_with_secure_postgres_password_in_production

# POSTGRES_PORT
# - Purpose: Local host port mapped to the PostgreSQL container in development.
# - Required: Optional (Defaults to `5432`).
# - Consumed by: `compose.dev.yaml` host port mapping (never exposed in production).
# - Secret: No.
# - Expected format: TCP port integer (e.g., `5432`).
# - Value source: Free TCP port on host machine.
POSTGRES_PORT=5432


# ==============================================================================
# 2. APPLICATION RUNTIME & SERVICE NETWORKING
# ==============================================================================

# ENVIRONMENT
# - Purpose: Distinguishes development, test, and production runtime behavior.
# - Required: Required (default: `development` in dev compose, `production` in prod compose).
# - Consumed by: All Python containers (`core`, `core-worker`, `ghs-api`, `ghs-worker`).
# - Secret: No.
# - Expected format: `development` | `production`.
# - Value source: Operator environment configuration.
ENVIRONMENT=development

# DEBUG
# - Purpose: Enables verbose debug output. MUST be `false` in production.
# - Required: Optional (default: `true` in dev, `false` in prod).
# - Consumed by: `core`, `ghs-api`.
# - Secret: No.
# - Expected format: `true` | `false`.
DEBUG=false

# CORE_PORT
# - Purpose: Host port mapped to Core API.
# - Required: Optional (default: `8000`).
# - Consumed by: `core` container port mapping (127.0.0.1:CORE_PORT:8000).
# - Secret: No.
# - Expected format: TCP port integer (e.g., `8000`).
CORE_PORT=8000

# GHS_PORT
# - Purpose: Host port mapped to GHS API in development.
# - Required: Optional (default: `8080`).
# - Consumed by: `ghs-api` in `compose.dev.yaml` (never published in production).
# - Secret: No.
# - Expected format: TCP port integer (e.g., `8080`).
GHS_PORT=8080

# FRONTEND_PORT
# - Purpose: Host port mapped to Vite development server in development.
# - Required: Optional (default: `5173`).
# - Consumed by: `frontend` in `compose.dev.yaml`.
# - Secret: No.
# - Expected format: TCP port integer (e.g., `5173`).
FRONTEND_PORT=5173

# GHS_BASE_URL
# - Purpose: HTTP URL used by Core and Core Worker to reach GHS API.
# - Required: Managed automatically by Compose internal DNS (`http://ghs-api:8080`).
# - Consumed by: `core`, `core-worker`.
# - Secret: No.
# - Expected format: Internal HTTP URL (`http://ghs-api:8080`).
GHS_BASE_URL=http://ghs-api:8080

# GHS_TIMEOUT_SECONDS
# - Purpose: Client timeout for Core requests to GHS API.
# - Required: Optional (default: `30.0`).
# - Consumed by: `core`, `core-worker`.
# - Secret: No.
# - Expected format: Positive float (seconds).
GHS_TIMEOUT_SECONDS=30.0


# ==============================================================================
# 3. CORE AUTHENTICATION, SESSIONS & DOMAIN ARCHITECTURE
# ==============================================================================

# JWT_SECRET_KEY
# - Purpose: Symmetric signing key for Core session cookies (HttpOnly).
# - Required: Optional in dev (falls back to dev secret); MANDATORY in production (>= 32 chars).
# - Consumed by: `core`. (Never passed to GHS or Frontend).
# - Secret: YES (Critical severity).
# - Expected format: Cryptographic random hex string (>= 32 characters).
# - Value source: Generated via `openssl rand -hex 32`.
JWT_SECRET_KEY=dev-only-jwt-secret-key-replace-before-production-32chars

# AUTH_COOKIE_NAME
# - Purpose: Cookie identifier for session cookie.
# - Required: Optional (default: `terra_session`).
# - Consumed by: `core`.
# - Secret: No.
# - Expected format: Cookie name string.
AUTH_COOKIE_NAME=terra_session

# AUTH_COOKIE_SECURE
# - Purpose: Requires HTTPS for session cookie transmission.
# - Required: Optional (default: `false` in dev, `true` in prod).
# - Consumed by: `core`.
# - Secret: No.
# - Expected format: `true` | `false`.
AUTH_COOKIE_SECURE=false

# CORS_ORIGINS
# - Purpose: Whitelisted origins permitted for cross-origin requests with credentials.
# - Required: Required in production.
# - Consumed by: `core`.
# - Secret: No.
# - Expected format: JSON list of strings (e.g., `["https://app.example.com"]`).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# FRONTEND_AUTH_REDIRECT_URL
# - Purpose: Destination URL where user is redirected after successful OAuth login.
# - Required: Required.
# - Consumed by: `core`.
# - Secret: No.
# - Expected format: Full HTTPS URL (e.g., `https://app.example.com/explore`).
FRONTEND_AUTH_REDIRECT_URL=http://localhost:5173/explore

# GITHUB_CLIENT_ID
# - Purpose: GitHub OAuth Application Client ID.
# - Required: Optional in dev (Core has /api/v1/auth/dev-session); required for live GitHub OAuth.
# - Consumed by: `core`.
# - Secret: No.
# - Expected format: GitHub client ID string.
# - Value source: GitHub Developer Settings -> OAuth Apps.
GITHUB_CLIENT_ID=

# GITHUB_CLIENT_SECRET
# - Purpose: GitHub OAuth Application Client Secret.
# - Required: Required if GITHUB_CLIENT_ID is set.
# - Consumed by: `core`.
# - Secret: YES (High severity).
# - Expected format: GitHub client secret string.
# - Value source: GitHub Developer Settings -> OAuth Apps.
GITHUB_CLIENT_SECRET=

# GITHUB_REDIRECT_URI
# - Purpose: OAuth callback endpoint registered in GitHub OAuth application settings.
# - Required: Required for OAuth flow.
# - Consumed by: `core`.
# - Secret: No.
# - Expected format: `https://api.example.com/api/v1/auth/github/callback`.
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback


# ==============================================================================
# 4. STORAGE & CLOUDFLARE R2 INTEGRATION
# ==============================================================================

# STORAGE_BACKEND
# - Purpose: Specifies object storage provider (`local` filesystem or `s3`/Cloudflare R2).
# - Required: Required (default: `local` in dev, `s3` in prod).
# - Consumed by: `core`, `core-worker`, `ghs-api`, `ghs-worker`.
# - Secret: No.
# - Expected format: `local` | `s3`.
STORAGE_BACKEND=local

# S3_BUCKET
# - Purpose: Name of the shared S3/Cloudflare R2 bucket.
# - Required: Required when STORAGE_BACKEND=s3.
# - Consumed by: `core`, `core-worker`, `ghs-api`, `ghs-worker`.
# - Secret: No.
# - Expected format: Bucket name string (e.g., `project-terra-data`).
# - Value source: Cloudflare Dashboard -> R2 Object Storage.
S3_BUCKET=

# S3_ENDPOINT_URL
# - Purpose: Account-level S3 API endpoint for Cloudflare R2 (WITHOUT trailing bucket name).
# - Required: Required when STORAGE_BACKEND=s3 with Cloudflare R2.
# - Consumed by: `core`, `core-worker`, `ghs-api`, `ghs-worker`.
# - Secret: No.
# - Expected format: `https://<ACCOUNT_ID>.r2.cloudflarestorage.com`.
# - Value source: Cloudflare Dashboard -> R2 Overview -> Account ID.
S3_ENDPOINT_URL=

# S3_REGION
# - Purpose: S3 Region identifier (`auto` for Cloudflare R2).
# - Required: Required when STORAGE_BACKEND=s3 (default: `auto`).
# - Consumed by: `core`, `core-worker`, `ghs-api`, `ghs-worker`.
# - Secret: No.
# - Expected format: `auto` (or AWS region name like `us-east-1`).
S3_REGION=auto

# AWS_ACCESS_KEY_ID
# - Purpose: Access Key ID for Cloudflare R2 / S3 API access.
# - Required: Required when STORAGE_BACKEND=s3.
# - Consumed by: `core`, `core-worker`, `ghs-api`, `ghs-worker`. (Never given to Frontend).
# - Secret: YES (Medium severity).
# - Expected format: R2 Token Access Key string.
# - Value source: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
AWS_ACCESS_KEY_ID=

# AWS_SECRET_ACCESS_KEY
# - Purpose: Secret Access Key for Cloudflare R2 / S3 API access.
# - Required: Required when STORAGE_BACKEND=s3.
# - Consumed by: `core`, `core-worker`, `ghs-api`, `ghs-worker`. (Never given to Frontend).
# - Secret: YES (High severity).
# - Expected format: R2 Token Secret string.
# - Value source: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
AWS_SECRET_ACCESS_KEY=

# CORE_S3_PREFIX
# - Purpose: Top-level prefix under which Core stores assessment JSON and provenance files.
# - Required: Optional (default: `core`).
# - Consumed by: `core`, `core-worker`.
# - Secret: No.
# - Expected format: Path prefix string (e.g., `core`).
CORE_S3_PREFIX=core

# GHS_S3_PREFIX
# - Purpose: Prefix for GHS raster storage zones (`raw/`, `intermediate/`, `derived/`).
# - Required: Optional (default: empty for root zones).
# - Consumed by: `ghs-api`, `ghs-worker`.
# - Secret: No.
# - Expected format: Path prefix string.
GHS_S3_PREFIX=

# S3_PRESIGN_TTL_SECONDS
# - Purpose: Lifetime in seconds for presigned download URLs issued by Core and GHS.
# - Required: Optional (default: `300`).
# - Consumed by: `core`, `ghs-api`.
# - Secret: No.
# - Expected format: Integer between 30 and 3600.
S3_PRESIGN_TTL_SECONDS=300

# GHS_HOST_SCRATCH_DIR
# - Purpose: Host directory for dedicated scratch raster processing (bind-mounted to /var/oled/terra_scratch in prod).
# - Required: Optional (default: `/var/oled/terra_scratch`).
# - Consumed by: `compose.prod.yaml` volume mount.
GHS_HOST_SCRATCH_DIR=/var/oled/terra_scratch

# GHS_STORAGE_TEMP_MAX_BYTES
# - Purpose: Maximum scratch filesystem budget in bytes for raster decompression and temporary warping.
# - Required: Optional (default: `5000000000` = 5.0 GB).
GHS_STORAGE_TEMP_MAX_BYTES=5000000000

# GHS_STORAGE_BUDGET_BYTES
# - Purpose: Aggregate GHS persistent storage ledger budget in bytes.
# - Required: Optional (default: `5000000000` = 5.0 GB).
GHS_STORAGE_BUDGET_BYTES=5000000000

# GHS_STORAGE_MAX_WORKER_CONCURRENCY
# - Purpose: Maximum number of concurrent ingestion/raster harmonization tasks per worker.
# - Required: Optional (default: `1` in production to respect RAM constraints).
GHS_STORAGE_MAX_WORKER_CONCURRENCY=1


# ==============================================================================
# 5. NASA & EARTH OBSERVATION DATA PROVIDERS
# ==============================================================================

# EARTHDATA_TOKEN
# - Purpose: Bearer token for authenticating against NASA Earthdata Cloud / DAACs.
# - Required: Required for live MODIS, GPM IMERG, and SMAP granule downloads.
# - Consumed by: `ghs-api`, `ghs-worker`. (Never given to Core, Frontend, or Postgres).
# - Secret: YES (High severity).
# - Expected format: Earthdata User Token string.
# - Value source: https://urs.earthdata.nasa.gov/user_tokens.
EARTHDATA_TOKEN=

# GHS_ADMIN_TOKEN
# - Purpose: Bearer token protecting GHS storage reconciliation and cleanup APIs.
# - Required: Optional (recommended in production).
# - Consumed by: `ghs-api`.
# - Secret: YES (Medium severity).
# - Expected format: Random hex string (>= 32 characters).
# - Value source: Generated via `openssl rand -hex 32`.
GHS_ADMIN_TOKEN=


# ==============================================================================
# 6. OPTIONAL CLOUDFLARE TUNNEL (PRODUCTION INGRESS)
# ==============================================================================

# CLOUDFLARE_TUNNEL_TOKEN
# - Purpose: Tunnel authentication token for the `cloudflared` container (profile: `tunnel`).
# - Required: Required only when running `docker compose --profile tunnel up`.
# - Consumed by: `cloudflared`. (Never baked into image or given to other containers).
# - Secret: YES (High severity).
# - Expected format: Base64-encoded Cloudflare Tunnel Token.
# - Value source: Cloudflare Zero Trust Dashboard -> Networks -> Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
